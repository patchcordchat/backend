NODE_ENV=development
# Server
SERVER_PORT=3000

# Crypto
APP_KEY=change-me

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=patchcord
MONGO_USERNAME=patchcord
